# Local defaults for the repository; never put credentials in this template.
DRIVE_SYNC_ROOT=/mnt/e/StarlinTirkey/repository
NODE_ENV=development
PORT=3000
DATABASE_URL=/mnt/e/StarlinTirkey/db_storage/meralocal.db

# EdgeBluePrint Compose settings
POSTGRES_DB=telemetry_db
POSTGRES_USER=edge_user
INGESTION_URL=http://node-ingestion:3000/telemetry
MAX_BUFFER_FILES=1000
MAX_BUFFER_BYTES=1073741824
UPLOAD_TIMEOUT_SECONDS=5
RETRY_BASE_SECONDS=1
DRAIN_INTERVAL_SECONDS=15
BATCH_INTERVAL_SECONDS=5

# Supply real secrets through local .env files or GitHub Actions secrets.
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=
OLLAMA_HOST=http://127.0.0.1:11434
