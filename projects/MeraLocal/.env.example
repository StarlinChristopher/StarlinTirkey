# Environment and host
NODE_ENV=development
PORT=3000

# Persistent data on the mounted E: drive
DATABASE_URL=/mnt/e/StarlinTirkey/db_storage/meralocal.db

# Configure a real Vault token locally; never commit it
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=

# Local offline inference engine
OLLAMA_HOST=http://127.0.0.1:11434
