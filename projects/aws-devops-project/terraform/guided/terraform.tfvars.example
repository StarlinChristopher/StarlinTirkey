aws_region                = "us-east-1"
aws_profile               = "aws-dev"
environment                = "dev"
container_image            = "123456789012.dkr.ecr.us-east-1.amazonaws.com/my-app@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
apprunner_access_role_arn = "arn:aws:iam::123456789012:role/AppRunnerECRAccessRole"
